# Normalise line endings so the repo does not churn between the macOS and
# Windows machines. Working copies get native endings; the repo stores LF.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never munge binaries.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.mindgraph text eol=lf
